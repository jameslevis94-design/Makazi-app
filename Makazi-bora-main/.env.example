# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APPWRITE INTEGRATION SETTINGS
VITE_APPWRITE_PROJECT_ID=""
VITE_APPWRITE_PROJECT_NAME="makazi"
VITE_APPWRITE_URL="https://nyc.cloud.appwrite.io/v1"
VITE_APPWRITE_DATABASE_ID=""
VITE_APPWRITE_POST_COLLECTION_ID=""
VITE_APPWRITE_USER_COLLECTION_ID=""
VITE_APPWRITE_REQUESTS_COLLECTION_ID=""
VITE_APPWRITE_ROLE_COLLECTION_ID=""
VITE_APPWRITE_SEND_COLLECTION_ID=""
VITE_APPWRITE_OWNER_COLLECTION_ID=""
VITE_APPWRITE_MESSAGES_COLLECTION_ID=""
VITE_APPWRITE_STORAGE_ID=""
VITE_APPWRITE_MEDIA_STORAGE_ID=""

# RING APPSTORE DEVELOPER PORTAL SETTINGS (OAUTH 2.0 INTEGRATION)
RING_CLIENT_ID=""
RING_CLIENT_SECRET=""
RING_REDIRECT_URI=""
RING_OAUTH_URL="https://oauth.ring.com/oauth/authorize"
RING_TOKEN_URL="https://oauth.ring.com/oauth/token"
RING_API_BASE_URL="https://api.ring.com"
RING_SCOPE="devices:read devices:write webhooks:subscribe settings:read"
RING_STATE="staging-state-ring-hq-2026"
